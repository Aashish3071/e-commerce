# ==========================================
# Openfront Environment Variables Template
# ==========================================

# 1. Database Connection (PostgreSQL)
# When deploying on Vercel with Neon, either use the direct non-pooling connection string or Vercel's POSTGRES_URL_NON_POOLING.
DATABASE_URL="postgresql://username:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. Keystone Session Secret (At least 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET="generate_a_secure_session_secret_at_least_32_chars_long"

# 3. Application URL (Optional on Vercel - automatically detected via VERCEL_URL)
NEXT_PUBLIC_BACKEND_URL="https://your-project.vercel.app"

# 4. Stripe Payment Provider (Optional)
NEXT_PUBLIC_STRIPE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 5. PayPal Payment Provider (Optional)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
NEXT_PUBLIC_PAYPAL_SANDBOX="true"

# 6. S3 / DigitalOcean Spaces File Storage (Optional)
S3_BUCKET_NAME="openfront-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"

# 7. SMTP Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourdomain.com"
SMTP_STORE_LINK="https://your-project.vercel.app"
